{
  "name": "registry-auto-test",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "scan": "node scripts/scan-registry.mjs",
    "start": "node scripts/scan-registry.mjs --watch & SCAN=$!; node scripts/e2e-runner.mjs & RUNNER=$!; ng serve; kill $SCAN $RUNNER 2>/dev/null",
    "prebuild": "node scripts/scan-registry.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test -c e2e",
    "e2e:ui": "playwright test -c e2e --ui",
    "e2e:report": "playwright show-report e2e/report"
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
