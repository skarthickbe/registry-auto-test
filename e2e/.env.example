# Copy to e2e/.env and fill in. e2e/.env is git-ignored.

# Registry App under test (run it with `ng serve --port 4300` so it does not clash with this tool on 4200).
REGISTRY_URL=http://lrg-staff-portal-app.s3-website-us-east-1.amazonaws.com

# Made-up account used for wrong-password tests, so failed attempts never lock a real user.
REGISTRY_FAKE_EMAIL=playwright.wrong-password@example.com

# Test account for pages behind sign-in (never a real person's account).
REGISTRY_EMAIL=
REGISTRY_PASSWORD=

# Patient used for routes with :id, e.g. /staff/patient/details/:id/101 (test data only).
REGISTRY_PATIENT_ID=
